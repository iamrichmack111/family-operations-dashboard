[Unit]
Description=Family Operations Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/opt/family-operations-dashboard
Environment="PATH=/opt/family-operations-dashboard/.venv/bin"
EnvironmentFile=-/etc/family-dashboard.env
ExecStart=/opt/family-operations-dashboard/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 wsgi:app
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
