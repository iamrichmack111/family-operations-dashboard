[Unit]
Description=Family Operations Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=richmack
Group=richmack
WorkingDirectory=/home/richmack/family-operations-dashboard
Environment="FAMILY_DASHBOARD_HOST=0.0.0.0"
Environment="FAMILY_DASHBOARD_PORT=8011"
EnvironmentFile=-/etc/family-dashboard.env
ExecStart=/home/richmack/family-operations-dashboard/.venv/bin/gunicorn --workers 2 --threads 2 --timeout 60 --bind 0.0.0.0:8011 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
